# ============================================
# ViralLinkUp - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/virallinkup

# JWT Authentication (generate with: openssl rand -base64 64)
JWT_SECRET=

# Site URL
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@virallinkup.com
EMAIL_FROM_NAME=ViralLinkUp

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
